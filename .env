# ==============================================================
# University Course Registration & Management System - Environment Config
# ==============================================================

# Django Core
SECRET_KEY=django-insecure-university-course-mgmt-key-replace-in-prod
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Backend: 'sqlite', 'postgresql', or 'mysql'
# Default fallback is 'sqlite' for immediate out-of-the-box runnability
DB_ENGINE=sqlite

# PostgreSQL Configuration (used when DB_ENGINE=postgresql)
DB_NAME=university_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# MySQL Configuration (used when DB_ENGINE=mysql)
# DB_NAME=university_db
# DB_USER=root
# DB_PASSWORD=root
# DB_HOST=localhost
# DB_PORT=3306

# Academic Policy Settings
MAX_CREDITS_PER_SEMESTER=18
DEFAULT_SEMESTER=Fall
DEFAULT_YEAR=2026
